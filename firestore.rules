rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && me().role == "admin";
    }

    function isApprovedStudent() {
      return signedIn()
        && me().role == "student"
        && me().status == "approved";
    }

    match /users/{userId} {
      // المستخدم ينشئ ملفه أثناء التسجيل، ثم يقرأ ملفه.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "student"
        && request.resource.data.status == "pending";

      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      // الطالب لا يستطيع تغيير صلاحياته أو حالته.
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.unlockedStageIds == resource.data.unlockedStageIds);

      allow delete: if isAdmin();
    }

    // محتوى التطبيق في مستند واحد، ويتحدث لحظيًا عبر onSnapshot.
    match /appData/curriculum {
      allow read: if isAdmin() || isApprovedStudent();
      allow write: if isAdmin();
    }
  }
}
